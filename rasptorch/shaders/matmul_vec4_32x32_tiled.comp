#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer ABuffer {
    float a[];
} buf_a;

layout(set = 0, binding = 1, std430) readonly buffer BBuffer {
    float b[];
} buf_b;

layout(set = 0, binding = 2, std430) writeonly buffer OBuffer {
    float o[];
} buf_o;

layout(push_constant) uniform PushConstants {
    uint m;
    uint n;
    uint k;
} pc;

shared float Asub[32][32];
shared float Bsub[32][32];

void main() {
    uint row = gl_GlobalInvocationID.y;
    uint col = gl_GlobalInvocationID.x;
    uint ly = gl_LocalInvocationID.y;
    uint lx = gl_LocalInvocationID.x;

    float sum = 0.0;
    uint tile_count = (pc.k + 31u) / 32u;

    for (uint t = 0u; t < tile_count; ++t) {
        uint a_col = t * 32u + lx;
        uint b_row = t * 32u + ly;

        Asub[ly][lx] = (row < pc.m && a_col < pc.k) ? buf_a.a[row * pc.k + a_col] : 0.0;
        Bsub[ly][lx] = (b_row < pc.k && col < pc.n) ? buf_b.b[b_row * pc.n + col] : 0.0;

        barrier();

        for (uint i = 0u; i < 32u; i += 4u) {
            vec4 a_vec = vec4(
                Asub[ly][i + 0u],
                Asub[ly][i + 1u],
                Asub[ly][i + 2u],
                Asub[ly][i + 3u]
            );
            vec4 b_vec = vec4(
                Bsub[i + 0u][lx],
                Bsub[i + 1u][lx],
                Bsub[i + 2u][lx],
                Bsub[i + 3u][lx]
            );
            sum += dot(a_vec, b_vec);
        }

        barrier();
    }

    if (row < pc.m && col < pc.n) {
        buf_o.o[row * pc.n + col] = sum;
    }
}